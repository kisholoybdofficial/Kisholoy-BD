# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Payment Gateways (SSLCOMMERZ / bKash)
SSLCOMMERZ_STORE_ID="kisholoy_live"
SSLCOMMERZ_STORE_PASSWORD="your_store_password"
SSLCOMMERZ_IS_SANDBOX="true"
BKASH_APP_KEY="your_bkash_app_key"
BKASH_APP_SECRET="your_bkash_app_secret"

# Logistics / Couriers (Steadfast / Pathao)
STEADFAST_API_KEY="your_steadfast_api_key"
STEADFAST_SECRET_KEY="your_steadfast_secret_key"
PATHAO_CLIENT_ID="your_pathao_client_id"
PATHAO_CLIENT_SECRET="your_pathao_secret"

# Transactional SMS Gateway (Onnorokom / Greenweb)
SMS_GATEWAY_API_KEY="your_sms_api_key"

# System Admin & Official Notifications
SYSTEM_ADMIN_EMAIL="kisholoybd.official@gmail.com"

# Resend Transactional Email Engine
RESEND_API_KEY=""
EMAIL_FROM="Kisholoy Official <noreply@kisholoy.com>"

# Upstash Serverless Redis (Distributed Cache, Rate-Limiting, Job Queues)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
REDIS_URL=""

# Supabase Management API & Cloud Replication
SUPABASE_URL="https://kisholoybd.supabase.co"
SUPABASE_API_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_ANON_KEY=""

# Render Deployment Automation API
RENDER_API_KEY=""

# GitHub Version Control & Repository Sync
GITHUB_API_TOKEN=""
GITHUB_REPO_KISHOLOY="https://github.com/kisholoybdofficial/kisholoy.git"
GITHUB_REPO_MEDUSA="https://github.com/medusajs/medusa.git"

# MongoDB Atlas Persistent Database
MONGODB_URI=""
MONGODB_DB_NAME="kisholoybd"

# Firebase Cloud Firestore & Service Account (kisholoybd)
FIREBASE_PROJECT_ID="kisholoybd"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-fbsvc@kisholoybd.iam.gserviceaccount.com"
FIREBASE_SERVICE_ACCOUNT_PATH="./firebase-service-account.json"
FIRESTORE_DATABASE_ID="ai-studio-a934f012-b48a-4be0-9d20-e7dc79923693"

# Sentry Application Performance & Error Monitoring
SENTRY_DSN_OR_KEY=""

