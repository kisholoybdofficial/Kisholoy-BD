# ─────────────────────────────────────────────────────────────────────────────
# Kisholoy-BD — environment template
#
# Names and descriptions ONLY. Never put a real secret in this file, never
# commit a filled-in copy, and never read `process.env` in feature code:
# `server/config.ts` is the single place that reads and validates environment
# variables, so a production boot fails loudly instead of falling back to a
# development default. Values that start with `your_`, `MY_` or end in `_HERE`
# are treated as UNSET by the config loader on purpose.
#
# Vercel: Project → Settings → Environment Variables (all of them, including
# the "sensitive" ones; the API runs in the same function as the app).
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime identity ─────────────────────────────────────────────────────────
# `production` turns on cookie Secure flags, strict CSP, fail-closed bootstrap
# and disables every seed/demo surface.
NODE_ENV="production"
# Public origin of the storefront: used for canonical URLs, cookies, CORS,
# payment gateway return URLs and email links. No trailing slash.
APP_URL="https://your-domain.example"
# HTTP port for container/Process Manager deployments (Vercel ignores it).
PORT="3000"

# ── REQUIRED in production — the app refuses to boot without these ──────────
# Signs session cookies and payment quotes. ≥ 32 characters, random, stored in
# the platform secret manager. Rotating it logs every user out (by design).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
KISHOLOY_SESSION_SECRET=""
# Separate key for IPN/shared-secret signatures; defaults to a derivative of
# the session secret, so set it explicitly if you rotate one without the other.
SECURITY_HMAC_SECRET=""
# Datastore. Without a reachable database the platform will not accept orders
# in production (see KISHOLOY_REQUIRE_PERSISTENCE below).
MONGODB_URI=""
MONGODB_DB_NAME="kisholoy"
# Accepted alias for MONGODB_URI (first non-empty wins); keep using MONGODB_URI.

# ── First administrator (bootstrap) ─────────────────────────────────────────
# There is no default, demo or backdoor admin account anywhere in the source or
# in the seed files. The very first boot creates exactly ONE super administrator
# from the values below, and that account must change its password before it can
# open any admin screen. Nothing here is shipped to the browser.
KISHOLOY_ADMIN_EMAIL=""
KISHOLOY_ADMIN_NAME="Kisholoy Super Administrator"
# Option A — give a one-time password and force a change on first login. It must
# satisfy the policy in server/security/passwords.ts (>= 10 characters, no
# sequences/breached values); it is hashed with scrypt on first boot and is
# never stored or logged in plaintext.
KISHOLOY_ADMIN_BOOTSTRAP_PASSWORD=""
# Option B (preferred when you can hash out-of-band) — supply an already-hashed
# password and leave BOOTSTRAP_PASSWORD empty. Format is exactly what
# `hashPassword()` writes: "scrypt$<N>$<saltHex>$<keyHex>". Generate it locally,
# with the input kept off the terminal echo and out of the shell history:
#   npx tsx scripts/hash-password.ts
KISHOLOY_ADMIN_PASSWORD_HASH=""
# Set to false only for automated provisioning that pre-hashes a password.
KISHOLOY_ADMIN_REQUIRE_PASSWORD_CHANGE="true"

# ── Sessions & cookies ──────────────────────────────────────────────────────
KISHOLOY_SESSION_TTL_HOURS="12"
KISHOLOY_SESSION_IDLE_MINUTES="60"
# Leave Secure on unless you are debugging over plain http://localhost.
KISHOLOY_COOKIE_SECURE="true"
# Lax is required: the payment gateway returns the browser to us with a top-level
# GET, and Strict would drop the session cookie on that hop.
KISHOLOY_COOKIE_SAMESITE="lax"
# Password-reset token binding pepper (optional extra domain separation).
KISHOLOY_RESET_PEPPER=""

# ── CORS & hardening ────────────────────────────────────────────────────────
# Exact origins, comma separated. Never `*` and never a wildcard prefix — with
# credentials on, a loose entry is an account takeover.
KISHOLOY_CORS_ORIGINS="https://your-domain.example,https://www.your-domain.example"
# Comma separated; `none` disables the header if a preview host needs it.
KISHOLOY_CSP=""
# frame-ancestors allowlist for embedders (leave empty unless you embed the app).
KISHOLOY_FRAME_ANCESTORS=""
KISHOLOY_MAX_BODY_SIZE="1mb"
# Per-IP request budget for the API (auth endpoints get a stricter limit).
KISHOLOY_RATE_LIMIT="240"
# Development-only escape hatch; ignored when NODE_ENV=production.
KISHOLOY_RATELIMIT_BYPASS_IPS=""

# ── Persistence driver (dev/preview) ─────────────────────────────────────────
# file  -> append-only NDJSON under KISHOLOY_DATA_DIR (default in development)
# mongo -> MONGODB_URI
# memory -> lost on every cold start; only for tests
KISHOLOY_PERSISTENCE_DRIVER="mongo"
KISHOLOY_DATA_DIR=".kisholoy-data"
# true (default in production) refuses order writes when no durable store is
# connected — an order that only lives in one isolate is a lost order.
KISHOLOY_REQUIRE_PERSISTENCE="true"

# ── Demo data / seeding — must stay off in production ───────────────────────
# Auto-seeding the public catalogue on boot. Leave false; run the seeder once,
# deliberately, from the CLI instead.
KISHOLOY_AUTO_SEED="false"
# Allows the 3 passwordless demo shopper accounts and demo staff content.
KISHOLOY_ALLOW_DEMO_DATA="false"
# Lets the payment routes mark a transaction PAID without a gateway
# confirmation. NEVER enable this where real money is involved.
KISHOLOY_ALLOW_DEMO_PAYMENTS="false"
# Password used only by `npm run seed` when creating vendor portal accounts.
KISHOLOY_SUPPLIER_SEED_PASSWORD=""

# ── Payments (server-side verification only) ─────────────────────────────────
# Without these, the storefront honestly reports "card payment unavailable" and
# only Cash on Delivery / manual claims can be offered.
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
SSLCOMMERZ_IS_SANDBOX="true"
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
BKASH_IS_SANDBOX="true"
# Shared secret that authenticates gateway IPN/webhook posts. Set the same value
# in the gateway's callback configuration.
KISHOLOY_IPN_SECRET=""

# ── Logistics (optional; orders still work without them) ────────────────────
STEADFAST_API_KEY=""
STEADFAST_SECRET_KEY=""
STEADFAST_BASE_URL="https://api.steadfast.com.bd"
PATHAO_BASE_URL="https://api.pathao.com"
PATHAO_CLIENT_ID=""
PATHAO_CLIENT_SECRET=""
PATHAO_USERNAME=""
PATHAO_PASSWORD=""
PATHAO_STORE_ID=""

# ── Messaging ───────────────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="Kisholoy <noreply@your-domain.example>"
SMS_GATEWAY_API_KEY=""
# Bcc/receipts mailbox used by notification flows, and the only destination the
# "send a test email" button may use. When it is blank the button answers 422
# instead of mailing an address that happens to be hardcoded in the bundle.
SYSTEM_ADMIN_EMAIL=""

# ── Payouts, backups & disaster recovery ────────────────────────────────────
# A supplier payout of this amount (BDT) or more is impossible without a step-up
# code from the signed-in staff member's enrolled authenticator. Lower it to
# tighten the rule; there is no value that turns the check off.
KISHOLOY_PAYOUT_MFA_THRESHOLD_BDT="50000"
# Offsite copy of the backup vault. With neither set, the DR panel reports
# "local-only" and failover readiness stays DEGRADED/STANDBY — it no longer
# claims an Asia-South1 S3 replica that does not exist.
BACKUP_S3_BUCKET=""
BACKUP_COLD_VAULT=""
BACKUP_RETENTION_DAYS="30"
BACKUP_RTO_TARGET_MINUTES="5"
BACKUP_RPO_TARGET_MINUTES="60"
# Google Drive / Sheets mirroring. `connected` is derived from these: the admin
# UI cannot declare a cloud connection that no credential backs, and
# POST /api/backups/drive/connect refuses while they are unset.
GOOGLE_SERVICE_ACCOUNT_JSON=""
GOOGLE_APPLICATION_CREDENTIALS=""
GOOGLE_DRIVE_FOLDER_ID=""
GOOGLE_DRIVE_FOLDER_NAME="KISHOLOY-Backups"

# ── Shared rate limiting (recommended on Vercel) ────────────────────────────
# Without Redis each serverless isolate counts separately, so the effective
# limit multiplies with concurrency.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
REDIS_URL=""

# ── Optional integrations (leave blank to keep the feature off) ─────────────
# Read by the server; an unset value degrades one feature, never the boot.
# Firebase/Firestore legacy mirror. Never paste a service-account JSON into a
# repo variable — mount the file and point at it.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_SERVICE_ACCOUNT_PATH=""
FIREBASE_PRIVATE_KEY=""
# Reported by GET /api/integrations/status and used by the deployment
# diagnostics card; blank means the panel says "not configured" instead of
# implying a working service.
SENTRY_DSN_OR_KEY=""
RENDER_API_KEY=""
GITHUB_API_TOKEN=""

# ── Not wired in this build (kept for reference; setting them changes nothing) ─
# Listed because older panels and docs mention them. Nothing in server/ or src/
# reads these, so do not spend an outage debugging a mirror that was never
# implemented — either wire the integration in code first, or drop these lines.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_ANON_KEY=""
FIRESTORE_DATABASE_ID=""
GEMINI_API_KEY=""
SMS_GATEWAY_API_KEY=""
REDIS_URL=""

# ── Local development only ──────────────────────────────────────────────────
# Used by `npm test` and by the test harness to keep logs out of the audit
# stream; also flips the fail-closed production rules off.
KISHOLOY_TESTS=""
KISHOLOY_TEST_LOG=""
DISABLE_HMR=""
